{
  "name": "zila-samanvay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zila Samanvay - Khagaria district dashboard and administrative workflow management (Problem Statement 3, Letter No. 305)",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch --clear-screen=false src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "start": "tsx src/server/index.ts --prod",
    "db:reset": "tsx src/server/reset.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "sql.js": "^1.12.0",
    "tsx": "^4.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.1.1",
    "@fontsource/noto-sans-devanagari": "^5.1.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
