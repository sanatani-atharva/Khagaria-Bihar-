# Copy to .env (or export in the shell) to override defaults.
# PORT=8080                 # production port only
# API_PORT=4000             # dev API port (the UI dev server on 5173 proxies /api to it)
# HOST=0.0.0.0
# DATA_DIR=./data           # where the SQLite file and session secret live
# SESSION_SECRET=           # >= 32 chars; generated into data/.session-secret if unset
# COOKIE_SECURE=1           # set when served over HTTPS
# DEMO_LOGIN=0              # disable one-click demo sign-in (production must use SSO/OTP)
# DB_ENGINE=sql.js          # force the WebAssembly SQLite engine (default: node:sqlite when available)
